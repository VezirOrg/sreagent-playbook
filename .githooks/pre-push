#!/bin/sh
# Re-check every commit about to leave this machine (names, contents, messages), so a commit made with
# --no-verify or before the hooks were installed is still caught.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # branch delete
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                                         # new ref: check its whole history
  else
    range="$remote_sha..$local_sha"
  fi
  echo "pre-push: scrub-check $remote_ref ($range)"
  "$root/scripts/scrub-check.sh" --range "$range" || status=1
done
[ $status -eq 0 ] || echo "pre-push: BLOCKED. Fix the commits (never push with --no-verify)."
exit $status
